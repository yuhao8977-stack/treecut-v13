@echo off
chcp 65001 >nul
echo Searching TreeCut install on E: ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$root = Get-ChildItem 'E:\' -Directory -Recurse -Depth 4 -Filter 'TreeCut_v13' -ErrorAction SilentlyContinue | Where-Object { (Test-Path (Join-Path $_.FullName 'runtime\pythonw.exe')) -and (Test-Path (Join-Path $_.FullName 'src\treecut\desktop.py')) } | Select-Object -First 1; if (-not $root) { Write-Output 'ERROR: TreeCut install not found on E:'; pause; exit 1 }; Write-Output ('Found: ' + $root.FullName); $f = Join-Path $root.FullName 'runtime_data\config\remote.json'; $j = Get-Content $f -Raw | ConvertFrom-Json; $j.hub_url = 'http://192.168.1.140:8766'; $j | ConvertTo-Json | Set-Content $f -Encoding UTF8; Get-CimInstance Win32_Process -Filter 'Name=pythonw.exe' | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; Start-Sleep -Seconds 2; $env:PYTHONPATH = Join-Path $root.FullName 'src'; Start-Process -FilePath (Join-Path $root.FullName 'runtime\pythonw.exe') -ArgumentList '-m','treecut.remote.agent_main' -WorkingDirectory $root.FullName -WindowStyle Hidden; Start-Sleep -Seconds 3; Start-Process -FilePath (Join-Path $root.FullName 'runtime\pythonw.exe') -ArgumentList '-m','treecut.watchdog' -WorkingDirectory $root.FullName -WindowStyle Hidden; Write-Output 'DONE - agent restarted, connecting to 192.168.1.140'"
pause
