      ]
    },
    {
      "visual_beat_id": "VB3_POWER",
      "text": "第二，轨道插座，吃火锅煮茶都方便，插拔也顺手",
      "shot_role": "FEATURE_DEMO",
      "preferred_visuals": [
        "track_socket_overview",
