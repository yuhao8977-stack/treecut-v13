@echo off
chcp 65001 >nul
echo ============================================
echo   树剪子机一键诊断+修复工具
echo ============================================
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=''; $py=Join-Path $env:TEMP 'treecut_child_fix.py'; [IO.File]::WriteAllBytes($py,[Convert]::FromBase64String($b)); $root=Get-ChildItem 'E:\' -Directory -Recurse -Depth 4 -Filter 'TreeCut_v13' -ErrorAction SilentlyContinue | Where-Object { (Test-Path (Join-Path $_.FullName 'runtime\python.exe')) -and (Test-Path (Join-Path $_.FullName 'src\treecut\desktop.py')) } | Select-Object -First 1; if(-not $root){Write-Output 'ERROR: E盘未找到 TreeCut_v13'; pause; exit 1}; Write-Output ('Found: '+$root.FullName); & (Join-Path $root.FullName 'runtime\python.exe') $py $root.FullName; exit $LASTEXITCODE"
echo.
echo 诊断完成，请把窗口内容发给主机侧 Codex。
pause