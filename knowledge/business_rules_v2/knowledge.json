     "YOLO",
     "SIGLIP",
     "ASR",
     "OCR",
     "MOTION_ASR",
     "HUMAN",
     "METADATA"
    ],
    "note": "同 provider 多字段 = 1 票；≥2 family 才计为 multi-source"
   },
