  {
   "knowledge_id": "CF001",
   "namespace": "business_rules_v2",
   "knowledge_type": "EVIDENCE_POLICY",
   "title": "ASR 口语 vs 视觉场景冲突",
   "statement": "ASR 出现 客户家/家里/入户/客厅/卧室 等词而 scene=FACTORY → CONFLICTING_EVIDENCE，resolution=CUSTOMER_HOME=UNKNOWN（不强行二选一）。",
   "structured_payload": {
    "rule_id": "CF001",
    "pattern": "scene=FACTORY + ASR home_words",
    "resolution": "CUSTOMER_HOME=UNKNOWN",
    "reason": "scene LIMITTED 且 ASR 口语不可作为场景硬证据"
   },
