# ============================================================
# TreeCut v13 独立仓库 .gitignore（GitHub 资产边界：A类开发资产上传，B/C类本地）
# ============================================================

# C 类敏感信息（绝对禁止上传）
.env
.env.*
!.env.example
*.key
*.pem
*.token
config.json

# B 类大文件/运行数据（仅本地）
# 模型权重
models/
*.safetensors
*.pt
*.pth
*.onnx
*.gguf

# 运行数据（数据库/缓存/日志/素材/输出）
runtime_data/
databases/
indexes/
keyframes/
thumbnails/
proxies/
asr_cache/
ocr_cache/
exports/
roughcuts/
logs/
temp/
cache/

# 素材与媒体
*.mp4
*.mov
*.mkv
*.avi
*.m4v
*.webm
*.mts
*.m2ts
*.mp3
*.wav
*.flac
02_BGM/
shipin/
AI素材库/

# 数据库
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 二进制运行时（自带 Python 环境，不纳入版本控制）
runtime/
unins000.dat
unins000.exe

# FFmpeg 二进制工具（通过安装包/官方渠道获取）
tools/win32/
ffmpeg.exe
ffprobe.exe

# 个人业务数据（微信视频清单等，绝不上传公开仓库）
docs/子机微信视频清单.csv

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
dist/
build/

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.bak
*.log

# Office lock files
~$*.md

# Phase 0 backups
backups/
BACKUP_MANIFEST.json

# ============================================================
# XHS Work Browser（§4/5/51）— 浏览器持久 Profile 与登录态，仅本地，绝不入库
# ============================================================
browser_profiles/
profiles/
*.part
# 浏览器内部登录数据文件（若 profile 目录被误放仓库则拒绝）
Cookies
Login Data
Local State
Network Persistent State
Preferences
Secure Preferences

